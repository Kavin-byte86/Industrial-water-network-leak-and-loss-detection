# Production build environment.
#
# For SAME-ORIGIN deployment (FastAPI serves the built frontend):
#   Leave VITE_API_BASE_URL empty — the client calls its own origin.
#
# For SPLIT-ORIGIN deployment (Vercel frontend + Render backend):
#   Set VITE_API_BASE_URL in Vercel's Environment Variables to the
#   Render service URL, e.g. https://your-backend.onrender.com
#   Do NOT set it here — Vercel env vars override this file.
VITE_API_BASE_URL=
